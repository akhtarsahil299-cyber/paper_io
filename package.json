{
  "name": "territory-io",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @territory/client",
    "build": "npm run build -w @territory/client",
    "typecheck": "tsc --noEmit -p apps/client && tsc --noEmit -p packages/shared",
    "test": "tsx --test packages/shared/test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
