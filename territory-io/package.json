{
  "name": "territory-io",
  "private": true,
  "version": "0.2.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:client": "npm run dev -w @territory/client",
    "build": "npm run build -w @territory/client",
    "start": "tsx apps/server/src/index.ts",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p apps/server && tsc --noEmit -p apps/client",
    "test": "tsx --test packages/shared/test/*.test.ts apps/server/test/*.test.ts"
  },
  "dependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "concurrently": "^9.0.0",
    "@types/node": "^20.14.0"
  }
}
